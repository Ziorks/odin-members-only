<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles.css">
  <title>Home</title>
</head>

<body>
  <% if(locals.currentUser) { %>
  <h1>Welcome back <%= currentUser.username %>!</h1>
  <div><a href="new-message">Create a New Message</a> <a href="/membership">Membership</a> <a href="/logout">Logout</a></div>
  <% } else { %>
  <h1>Welcome!</h1>
  <p>Please <a href="/login">login</a> or <a href="/sign-up">sign up</a> to get started.</p>
  <% } %>
  <br>
  <h2>Messages</h2>
  <br>
  <% if (messages.length > 0) { %>
  <ol>
    <% messages.forEach(message=>{ %>
    <li>
      <p>Title: <%= message.title %></p>
      <p>Message: <%= message.body %></p>
      <p>User: <%= message.username %></p>
      <p>Posted: <%= message.timestamp %></p>
      <% if (currentUser && currentUser.admin) { %>
      <form action="/message/<%= message.id %>/delete" method="post" onsubmit="return confirm('Are you sure you want to delete this message forever?')">
        <button type="submit">Delete</button>
      </form>
      <% } %>
    </li>
    <br>
    <% }) %>
  </ol>
  <% } else { %>
  <p>There are no messages.</p>
  <% } %>
</body>

</html>