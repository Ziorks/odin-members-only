<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles.css">
  <title>Membership</title>
</head>

<body>
  <h1>Membership Status: <%= currentUser.member ? 'Active' : 'Inactive' %></h1>
  <% if (currentUser.member) { %>
  <a href="/">Back to Home</a>
  <% } else { %>
  <p>Simply enter the secret code and membership is yours.</p>
  <%- include('partials/errors.ejs') %>
  <form action="/membership" method="post">
    <div>
      <label for="membershipSecret">Secret Code: </label>
      <input type="password" name="membershipSecret" id="membershipSecret" required>
    </div>
    <button type="submit">Submit</button>
  </form>
  <% } %>
</body>

</html>