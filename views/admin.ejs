<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles.css">
  <title>Admin</title>
</head>

<body>
  <h1>Admin Status: <%= currentUser.admin ? "Active" : 'Inactive' %></h1>
  <% if (currentUser.admin) { %>
  <a href="/">Back to Home</a>
  <% } else { %>
  <p>Just enter the secret code and you too can be an admin.</p>
  <%- include('partials/errors.ejs') %>
  <form action="/admin" method="post">
    <div>
      <label for="adminSecret">Secret Code: </label>
      <input type="password" name="adminSecret" id="adminSecret" required>
    </div>
    <button type="submit">Submit</button>
  </form>
  <% } %>
</body>

</html>